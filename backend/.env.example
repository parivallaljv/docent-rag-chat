# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWT_AUD=authenticated
SUPABASE_STORAGE_BUCKET=documents

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
CHAT_MODEL=gemini-3.6-flash
CHAT_MODEL_FALLBACKS=gemini-3.7-flash,gemini-flash-latest
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_DAILY_QUOTA=50

# --- Groq (optional cross-vendor chat fallback) ---
# Used only as a last resort after every Gemini model above has failed or
# timed out. Free, no credit card -- get a key at console.groq.com/keys.
# Leave blank to skip this fallback entirely (chat still works via Gemini).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- CORS: comma-separated list of allowed frontend origins ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Retrieval / generation tuning (defaults shown) ---
RETRIEVAL_TOP_N=20
RERANK_TOP_K=5
MMR_LAMBDA=1.0
SIMILARITY_THRESHOLD=0.55
MAX_PROMPT_TOKENS=4000
HISTORY_TURNS=5

# --- Chunking ---
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_RATIO=0.15

# --- Operations (all optional) ---
LOG_FORMAT=json            # json | text (text is nicer locally)
METRICS_TOKEN=             # set to enable GET /metrics (Authorization: Bearer <token>)
PER_USER_RATE_LIMIT=10     # chat turns per user per window (per process)
PER_USER_RATE_WINDOW_SECONDS=60

# --- Agentic search (off by default; +1..3 LLM calls per turn) ---
AGENTIC_SEARCH=false
AGENT_MODEL=               # empty = CHAT_MODEL chain; a "-lite" model is plenty for planning

# --- Agent modes (need AGENTIC_SEARCH=true) ---
AGENT_MODE=search          # search | tools (multi-tool loop) | plan (plan-and-execute)
AGENT_MAX_STEPS=3
AGENT_MAX_TOOL_CALLS=6
CRITIC_ENABLED=false       # +1 LLM call/turn: flags unsupported claims in the answer
CRITIC_MODEL=

# --- Retrieval upgrades (measured in eval/results/extras.json; all off) ---
HYDE=false                 # best measured gain: recall@5 0.81 -> 0.91; +1 LLM call/turn
HYDE_MODEL=
RERANKER=                  # "llm" = listwise LLM rerank (measured: worse on our corpus)
RERANK_MODEL=
CONTEXTUAL_CHUNKS=false    # LLM context sentence per chunk at ingestion (measured: worse on a tiny corpus)
CONTEXT_MODEL=
SEMANTIC_CACHE=false       # reuse answers to near-identical single-turn questions (in-process)
SEMANTIC_CACHE_THRESHOLD=0.95

# --- Multimodal / memory (need migration 008 for tags, summary, memory) ---
FIGURE_CAPTIONS=false      # describe PDF figures/tables with a vision model (extra LLM cost)
FIGURE_MODEL=
AUTO_TAGS=false
CHAT_SUMMARY=false         # rolling summary of long chats
USER_MEMORY=true           # inject the user's own notes (GET/PUT /memory); no LLM cost

# --- LLMOps ---
# Langfuse tracing is opt-in. Only metadata is sent unless LANGFUSE_CAPTURE_CONTENT=true.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_CAPTURE_CONTENT=false
COST_PER_1M_INPUT_USD=0    # for the /usage cost estimate
COST_PER_1M_OUTPUT_USD=0
ROUTING_ENABLED=false      # fast model for simple questions, strong for analytical ones
CHAT_MODEL_FAST=
CHAT_MODEL_STRONG=
OLLAMA_BASE_URL=           # e.g. http://localhost:11434 -> local model as last fallback
OLLAMA_MODEL=llama3.2

# --- Human-in-the-loop + parent-child context ---
AGENT_PROPOSALS=false      # tools agent may PROPOSE saving a memory note; user must approve in the UI
CHUNK_NEIGHBORS=0          # parent-child: add N neighbouring chunks per side to each excerpt (unmeasured)
