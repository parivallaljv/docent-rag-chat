# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWT_AUD=authenticated
SUPABASE_STORAGE_BUCKET=documents

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
CHAT_MODEL=gemini-3.6-flash
CHAT_MODEL_FALLBACKS=gemini-3.7-flash,gemini-flash-latest
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_DAILY_QUOTA=50

# --- Groq (optional cross-vendor chat fallback) ---
# Used only as a last resort after every Gemini model above has failed or
# timed out. Free, no credit card -- get a key at console.groq.com/keys.
# Leave blank to skip this fallback entirely (chat still works via Gemini).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- CORS: comma-separated list of allowed frontend origins ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Retrieval / generation tuning (defaults shown) ---
RETRIEVAL_TOP_N=20
RERANK_TOP_K=5
MMR_LAMBDA=1.0
SIMILARITY_THRESHOLD=0.55
MAX_PROMPT_TOKENS=4000
HISTORY_TURNS=5

# --- Chunking ---
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_RATIO=0.15

# --- Operations (all optional) ---
LOG_FORMAT=json            # json | text (text is nicer locally)
METRICS_TOKEN=             # set to enable GET /metrics (Authorization: Bearer <token>)
PER_USER_RATE_LIMIT=10     # chat turns per user per window (per process)
PER_USER_RATE_WINDOW_SECONDS=60

# --- Agentic search (off by default; +1..3 LLM calls per turn) ---
AGENTIC_SEARCH=false
AGENT_MODEL=               # empty = CHAT_MODEL chain; a "-lite" model is plenty for planning
