# Supabase project settings (Project Settings -> API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the FastAPI backend. The browser calls this directly for
# uploads/ingestion and streamed chat - it is never proxied through Next.js.
NEXT_PUBLIC_API_URL=http://localhost:8000
